# ============================================================
# BĐS Collector Web - Production Environment Variables
# ------------------------------------------------------------
# Dùng file này làm mẫu khi cấu hình Environment Variables trên Vercel:
# Dashboard -> Settings -> Environment Variables
# ============================================================

# BẮT BUỘC: Supabase Project URL (HTTPS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# BẮT BUỘC: Supabase Anon Public API Key (JWT public anon key)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# BẮT BUỘC: Publishable Key cho Edge Function r2-media-sign (sb_publishable_...)
VITE_ACTIVATION_PUBLISHABLE_KEY=sb_publishable_your_key_here

# TÙY CHỌN: Google Gemini API Key cho trích xuất BĐS bằng AI (nếu dùng)
VITE_GEMINI_API_KEY=

# ============================================================
# CẢNH BÁO BẢO MẬT (SECURITY WARNING):
# TUYỆT ĐỐI KHÔNG đưa các Secret Keys sau vào Web Frontend:
# - SUPABASE_SERVICE_ROLE_KEY  (Chỉ lưu trên Supabase server)
# - R2_ACCESS_KEY_ID           (Chỉ lưu trên Supabase Edge Function Secrets)
# - R2_SECRET_ACCESS_KEY       (Chỉ lưu trên Supabase Edge Function Secrets)
# ============================================================
