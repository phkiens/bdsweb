# ============================================================
# BĐS Collector Web - Environment Variables Template
# ------------------------------------------------------------
# Copy this file to .env or .env.local and fill in your values:
# cp .env.example .env.local
# ============================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public API Key (JWT token)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Gemini API Key for property text parsing (starts with AIzaSy...)
VITE_GEMINI_API_KEY=your-gemini-api-key-here
